{
  "font": {
    "$type": "fontFamily",
    "body": {
      "$value": "{font.sans}"
    },
    "heading": {
      "$value": "{font.sans}"
    },
    "sans": {
      "$value": [
        "Geist",
        "Inter",
        "-apple-system",
        "BlinkMacSystemFont",
        "Segoe UI",
        "Roboto",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ]
    },
    "mono": {
      "$value": [
        "Geist Mono",
        "SFMono-Regular",
        "Consolas",
        "Liberation Mono",
        "Menlo",
        "monospace"
      ]
    },
    "serif": {
      "$value": [
        "Georgia",
        "Cambria",
        "Times New Roman",
        "Times",
        "serif"
      ]
    },
    "weight": {
      "$type": "fontWeight",
      "normal": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      },
      "extrabold": {
        "$value": 800
      }
    }
  },
  "text": {
    "xs": {
      "$value": "{size.step.-1}"
    },
    "sm": {
      "$value": "{size.step.-1}"
    },
    "base": {
      "$value": "{size.step.0}"
    },
    "lg": {
      "$value": "{size.step.1}"
    },
    "xl": {
      "$value": "{size.step.2}"
    },
    "2xl": {
      "$value": "{size.step.3}"
    },
    "3xl": {
      "$value": "{size.step.4}"
    }
  },
  "heading": {
    "1": {
      "$value": "{text.3xl}"
    },
    "2": {
      "$value": "{text.2xl}"
    },
    "3": {
      "$value": "{text.xl}"
    },
    "4": {
      "$value": "{text.lg}"
    },
    "5": {
      "$value": "{text.base}"
    }
  },
  "body": {
    "default": {
      "$value": "{text.base}"
    },
    "large": {
      "$value": "{text.lg}"
    },
    "small": {
      "$value": "{text.sm}"
    }
  },
  "caption": {
    "$value": "{text.xs}"
  },
  "leading": {
    "$type": "number",
    "heading": {
      "$value": "{leading.tight}"
    },
    "body": {
      "$value": "{leading.relaxed}"
    },
    "title": {
      "$value": "{leading.tight}"
    },
    "none": {
      "$value": 1
    },
    "tight": {
      "$value": 1.2
    },
    "normal": {
      "$value": 1.4
    },
    "relaxed": {
      "$value": 1.6
    }
  },
  "tracking": {
    "$type": "dimension",
    "tight": {
      "$value": {
        "value": -0.025,
        "unit": "rem"
      }
    },
    "normal": {
      "$value": {
        "value": 0,
        "unit": "rem"
      }
    },
    "wide": {
      "$value": {
        "value": 0.025,
        "unit": "rem"
      }
    }
  }
}
