<!doctype html>
<html lang="en-ca">
  <head>
      {{ include 'layouts/partials/meta.vto' }}
  </head>
  <body class="menu">
    <header>
        <div class="[ global ] [ inverse ]">
          <div class="[ wrapper ] [ switcher ] [ step--1 ]">
            <div>
              <a rel="external" href="https://idrc.ocadu.ca/">
                An Inclusive Design Research Centre Project
              </a>
            </div>
            <ul role="list" class="[ flex ]" data-grow="false" data-separator="/">
              <li>
                <a href="/" lang="en-CA" hreflang="en-CA" aria-current="page"
                  >English</a
                >
              </li>
              <li>
                <a href="/fr/" lang="fr-CA" hreflang="fr-CA">Français</a>
              </li>
            </ul>
          </div>
        </div>
        <div class="[ brand ]">
            <a rel="home" href="/" aria-label="Financial Inclusion and Resilience Movement"> {{ include 'svg/firm-wordmark.svg' }} </a>
        </div>
    </header>
    <main>
        <h1 class="visually-hidden" id="site-menu">Site Navigation</h1>
        <nav class="[ navigation ]" aria-labelledby="site-menu">
        <div class="[ wrapper ]">
          <div class="[ menu-toggle ]">
            <a
              class="button"
              href="/"
              onClick="document.referrer ? history.back() : window.location.href = '/'; return false;"
              aria-label="Close menu"
            >

              <svg
                role="presentation"
                class="close icon"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="22"
                fill="none"
              >
                <path
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="4"
                  d="m21.375 2-19 18M2.375 2l19 18"
                ></path>
              </svg>
            </a>
          </div>
            <ul role="list">
              <li>
                <a class="link" href="/#about">About</a>

                <button
                  class="button"
                  aria-expanded="false"
                  aria-label="About"
                >
                  {{ include 'svg/disclosure.svg' }}
                </button>
                <ul role="list">
                  <li>
                    <a
                      class="link"
                      href="/#governance"
                      >Governance</a
                    >
                  </li>
                </ul>
              </li>

                <li>
                    <a class="link" href="/#events-and-activities">Events and Activities</a>
                </li>

              <li>
                <a class="link" href="/#knowledge-hub">Knowledge Hub</a>

                <button
                  class="button"
                  aria-expanded="false"
                  aria-label="Knowledge Hub"
                >
                  {{ include 'svg/disclosure.svg' }}
                </button>
                <ul role="list">
                  <li>
                    <a class="link" href="/#submit-resources"
                      >Submit Resources</a
                    >
                  </li>

                  <li>
                    <a class="link" href="/#resources"
                      >Member and Patron Resources</a
                    >
                  </li>
                </ul>
              </li>

              <li>
                <a class="link" href="/#members">Members</a>

                <button
                  class="button"
                  aria-expanded="false"
                  aria-label="Members"
                >
                  {{ include 'svg/disclosure.svg' }}
                </button>
                <ul role="list">
                  <li>
                    <a class="link" href="/#organization-directory"
                      >Organization Directory</a
                    >
                  </li>

                  <li>
                    <a class="link" href="/#shared-services"
                      >Shared Services</a
                    >
                  </li>
                </ul>
              </li>
              <li>
                <a class="link" href="/#patrons">Patrons</a>

                <button
                  class="button"
                  aria-expanded="false"
                  aria-label="Patrons"
                >
                  {{ include 'svg/disclosure.svg' }}
                </button>
                <ul role="list">
                  <li>
                    <a class="link" href="/#mailing-lis"
                      >Mailing List</a
                    >
                  </li>
                </ul>
              </li>
            </ul>
        </div>
      </nav>
    </header>
    {{ include 'layouts/partials/sw.vto' }}
  </body>
</html>
