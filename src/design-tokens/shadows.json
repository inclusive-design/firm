            "value": 0,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 1.5,
            "unit": "px"
          },
          "color": "{color.action.border.hover}"
        }
      },
      "focus": {
